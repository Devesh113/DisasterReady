# DisasterReady Frontend Environment Variables
NEXT_PUBLIC_APP_NAME="DisasterReady"
NEXT_PUBLIC_APP_DESCRIPTION="Disaster Awareness, Preparedness, and Emergency Response Platform"

# Backend API proxy URL (Next.js server-side rewrite destination)
# Verified default backend port: 5001
BACKEND_PORT=5001
BACKEND_URL=http://localhost:5001

# Public API Base URL used by client-side browser requests
# By defaulting to empty string or relative '/api/v1', requests go through Next.js rewrite proxy to avoid CORS
NEXT_PUBLIC_API_BASE_URL=/api/v1
