// ============================================================================
// DisasterReady — Prisma Database Schema
// Database: PostgreSQL
// ORM: Prisma
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  CITIZEN
  AUTHORITY
  ADMIN
}

enum AlertSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

enum IncidentReportStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  RESOLVED
  REJECTED
}

enum ResourceType {
  SHELTER
  HOSPITAL
  FIRE_STATION
  POLICE_STATION
  SUPPLY_CENTER
  EVACUATION_POINT
  WATER_SOURCE
  OTHER
}

enum SimulationStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum DisasterType {
  EARTHQUAKE
  FLOOD
  CYCLONE
  TSUNAMI
  WILDFIRE
  LANDSLIDE
  DROUGHT
  VOLCANIC_ERUPTION
  TORNADO
  INDUSTRIAL_ACCIDENT
  OTHER
}

enum NotificationType {
  ALERT
  EVENT_REMINDER
  INCIDENT_UPDATE
  GENERAL
}

// ============================================================================
// MODELS
// ============================================================================

/// Represents a registered user of the platform.
/// Supports CITIZEN, AUTHORITY and ADMIN roles.
/// Designed for extensibility — new roles (e.g., SCHOOL) can be added to the enum.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  role      UserRole @default(CITIZEN)
  phone     String?
  avatarUrl String?  @map("avatar_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // -- Relationships --
  alerts           Alert[]
  events           Event[]
  registrations    Registration[]
  notifications    Notification[]
  incidentReports  IncidentReport[]
  preparednessItems PreparednessItem[]
  simulationAttempts SimulationAttempt[]
  sessions         Session[]

  @@index([role])
  @@index([email])
  @@map("users")
}

/// Represents a type of disaster (e.g., Earthquake, Flood).
/// Serves as a reference entity linked to alerts and simulation scenarios.
model Disaster {
  id          String       @id @default(uuid())
  name        String       @unique
  type        DisasterType
  description String
  guidelines  String?      // General preparedness guidelines
  iconUrl     String?      @map("icon_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // -- Relationships --
  alerts              Alert[]
  simulationScenarios SimulationScenario[]

  @@index([type])
  @@map("disasters")
}

/// Represents a live disaster alert issued by an authority user.
/// Each alert is tied to a specific disaster type and an issuing authority.
model Alert {
  id          String        @id @default(uuid())
  title       String
  description String
  severity    AlertSeverity
  status      AlertStatus   @default(ACTIVE)
  latitude    Float?
  longitude   Float?
  radius      Float?        // Affected radius in kilometers
  issuedAt    DateTime      @default(now()) @map("issued_at")
  expiresAt   DateTime?     @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // -- Foreign Keys --
  disasterId String   @map("disaster_id")
  issuedById String   @map("issued_by_id")

  // -- Relations --
  disaster   Disaster @relation(fields: [disasterId], references: [id])
  issuedBy   User     @relation(fields: [issuedById], references: [id])

  @@index([status])
  @@index([severity])
  @@index([disasterId])
  @@index([issuedById])
  @@map("alerts")
}

/// Represents a mock drill, training session, or community event
/// organized by an authority user.
model Event {
  id          String      @id @default(uuid())
  title       String
  description String
  status      EventStatus @default(UPCOMING)
  location    String
  latitude    Float?
  longitude   Float?
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  capacity    Int?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // -- Foreign Keys --
  organizerId String @map("organizer_id")

  // -- Relations --
  organizer     User           @relation(fields: [organizerId], references: [id])
  registrations Registration[]

  @@index([status])
  @@index([organizerId])
  @@index([startDate])
  @@map("events")
}

/// Represents a citizen's registration for an event.
/// Enforces uniqueness: a user can register for a given event only once.
model Registration {
  id        String             @id @default(uuid())
  status    RegistrationStatus @default(REGISTERED)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  // -- Foreign Keys --
  userId  String @map("user_id")
  eventId String @map("event_id")

  // -- Relations --
  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("registrations")
}

/// Represents a notification sent to a user.
/// Can be triggered by alerts, event reminders, incident updates, or general system messages.
model Notification {
  id        String           @id @default(uuid())
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  // -- Foreign Keys --
  userId String @map("user_id")

  // -- Relations --
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

/// Represents an emergency resource or safe shelter location.
/// Used for the Emergency Map and Safe Shelter Locator feature.
model EmergencyResource {
  id          String       @id @default(uuid())
  name        String
  type        ResourceType
  description String?
  address     String
  latitude    Float
  longitude   Float
  phone       String?
  capacity    Int?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([type])
  @@index([isActive])
  @@index([latitude, longitude])
  @@map("emergency_resources")
}

/// Represents an incident report submitted by a citizen.
/// Tracks the lifecycle from submission through review to resolution.
model IncidentReport {
  id          String               @id @default(uuid())
  title       String
  description String
  status      IncidentReportStatus @default(SUBMITTED)
  latitude    Float?
  longitude   Float?
  address     String?
  imageUrl    String?              @map("image_url")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  // -- Foreign Keys --
  reportedById String @map("reported_by_id")

  // -- Relations --
  reportedBy User @relation(fields: [reportedById], references: [id])

  @@index([status])
  @@index([reportedById])
  @@index([createdAt])
  @@map("incident_reports")
}

/// Represents a single item in a citizen's personal emergency preparedness kit.
/// Citizens can build and maintain their own checklist.
model PreparednessItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   // e.g., "First Aid", "Food & Water", "Documents"
  isReady     Boolean  @default(false) @map("is_ready")
  quantity    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // -- Foreign Keys --
  userId String @map("user_id")

  // -- Relations --
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([category])
  @@map("preparedness_items")
}

/// Represents a disaster simulation scenario available in the Unity game.
/// Each scenario is linked to a disaster type and has configurable parameters.
model SimulationScenario {
  id              String   @id @default(uuid())
  title           String
  description     String
  difficultyLevel Int      @default(1) @map("difficulty_level") // 1-5 scale
  durationMinutes Int      @default(10) @map("duration_minutes")
  maxScore        Int      @default(100) @map("max_score")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // -- Foreign Keys --
  disasterId String @map("disaster_id")

  // -- Relations --
  disaster Disaster            @relation(fields: [disasterId], references: [id])
  attempts SimulationAttempt[]

  @@index([disasterId])
  @@index([isActive])
  @@index([difficultyLevel])
  @@map("simulation_scenarios")
}

/// Represents a single attempt by a user to complete a simulation scenario.
/// Tracks score, time spent, and completion status.
model SimulationAttempt {
  id            String           @id @default(uuid())
  status        SimulationStatus @default(IN_PROGRESS)
  score         Int?
  timeSpentSecs Int?             @map("time_spent_secs")
  startedAt     DateTime         @default(now()) @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // -- Foreign Keys --
  userId     String @map("user_id")
  scenarioId String @map("scenario_id")

  // -- Relations --
  user      User                @relation(fields: [userId], references: [id])
  scenario  SimulationScenario  @relation(fields: [scenarioId], references: [id])
  decisions SimulationDecision[]

  @@index([userId])
  @@index([scenarioId])
  @@index([status])
  @@map("simulation_attempts")
}

/// Represents a decision made by the user during a simulation attempt.
/// Captures the in-game choices for scoring, feedback and analytics.
model SimulationDecision {
  id            String   @id @default(uuid())
  stepNumber    Int      @map("step_number")
  situation     String   // Description of the in-game situation presented
  chosenOption  String   @map("chosen_option")
  isCorrect     Boolean  @map("is_correct")
  pointsAwarded Int      @default(0) @map("points_awarded")
  timeTakenSecs Int?     @map("time_taken_secs")
  createdAt     DateTime @default(now()) @map("created_at")

  // -- Foreign Keys --
  attemptId String @map("attempt_id")

  // -- Relations --
  attempt SimulationAttempt @relation(fields: [attemptId], references: [id])

  @@index([attemptId])
  @@index([stepNumber])
  @@map("simulation_decisions")
}

/// Represents an authenticated user session bound to a cryptographically hashed Refresh Token.
model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // -- Relationships --
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}


